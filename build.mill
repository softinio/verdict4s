//| mill-jvm-version: system
//| mvnDeps:
//|   - com.goyeau::mill-git::0.3.2

import mill.*
import mill.scalalib.*
import mill.scalajslib.*
import mill.scalalib.publish.*
import com.goyeau.mill.git.GitVersionedPublishModule

val scalaVersions = Seq("3.3.8", "3.9.0")
val scalaJSVer    = "1.22.0"

val catsVersion       = "2.13.0"
val catsEffectVersion = "3.7.1"
val fs2Version        = "3.14.0"
val circeVersion      = "0.14.16"
val http4sVersion     = "0.23.37"
val http4sDomVersion  = "0.2.12"
val ironVersion       = "3.3.2"
val munitVer      = "1.3.6"
val munitCeVer    = "2.2.1"

/** Scaladoc options shared by each module's own docs and by the combined
  * reference the site publishes, so the two cannot drift.
  */
def docOptions(title: String, version: String): Seq[String] = Seq(
  "-project",
  title,
  "-project-version",
  version,
  "-social-links:github::https://github.com/softinio/verdict4s",
  "-groups",
  "-external-mappings:" + Seq(
    // Third-party types link to their own published API docs. The patterns
    // match a symbol's *package path* (cats/kernel/Eq...), not the jar name:
    // that is why `.*scala.*` and `.*java.*` below work. Order matters, first
    // match wins, so cats-kernel precedes cats. Only docs verified to resolve
    // are listed -- a broken link is worse than plain text.
    s".*cats/kernel/.*::scaladoc3::https://javadoc.io/static/org.typelevel/cats-kernel_3/$catsVersion/",
    s".*cats/(data|syntax|instances|Show|Order|Eq).*::scaladoc3::https://javadoc.io/static/org.typelevel/cats-core_3/$catsVersion/",
    s".*io/github/iltotore/iron/.*::scaladoc3::https://javadoc.io/static/io.github.iltotore/iron_3/$ironVersion/",
    // javadoc.io has not unpacked these versions, so they link to the
    // projects' own hosted docs, which are Scala 2 scaladoc sites.
    ".*cats/effect/.*::scaladoc2::https://typelevel.org/cats-effect/api/3.x/",
    ".*io/circe/.*::scaladoc2::https://circe.github.io/circe/api/",
    ".*org/http4s/.*::scaladoc2::https://http4s.org/v0.23/api/",
    ".*scala.*::scaladoc3::https://scala-lang.org/api/3.x/",
    ".*java.*::javadoc::https://docs.oracle.com/en/java/javase/21/docs/api/"
  ).mkString(",")
)

/** Mill's scaladoc defaults already carry `-project <artifactName>`. Appending
  * our own `-project` then makes scaladoc warn that the option was updated, so
  * drop Mill's before adding ours.
  */
def withoutDefaultProject(options: Seq[String]): Seq[String] =
  options.indexOf("-project") match
    case -1 => options
    case i  => options.patch(i, Nil, 2)

/** Shared settings for every published module, on every platform.
  *
  * `PlatformScalaModule` drops the trailing `jvm`/`js` path segment, so both
  * platforms of a module share one directory: `<module>/src` for common code
  * and `<module>/src-jvm` / `<module>/src-js` for platform-specific code.
  */
trait Verdict4sModule
    extends ScalaModule
    with CrossScalaModule
    with PlatformScalaModule
    with GitVersionedPublishModule:

  /** Title shown in the generated Scaladoc. */
  def docTitle: String

  /** Blurb for the published POM. */
  def docDescription: String

  /** All Scala 3.x releases are mutually binary compatible, so everything
    * publishes under the `_3` suffix regardless of which 3.x compiled it.
    */
  override def artifactScalaVersion: T[String] = Task {
    val v = crossScalaVersion
    if v.startsWith("3.") then "3"
    else v.split('.').take(2).mkString(".")
  }

  def scalacOptions =
    val common = Seq("-explain", "-explain-types", "-deprecation", "-feature")
    // `-Xkind-projector` landed after the 3.3 LTS line, which only has `-Ykind-projector`.
    if crossScalaVersion.startsWith("3.3.") then common
    else common :+ "-Xkind-projector:underscores"

  def scalaDocOptions = Task {
    val version = Task.env.get("VERDICT4S_DOC_VERSION").getOrElse(publishVersion())
    withoutDefaultProject(super.scalaDocOptions()) ++ docOptions(docTitle, version)
  }

  /** Emits `<info.versionScheme>early-semver</info.versionScheme>` into the POM.
    * sbt reads it to decide whether a version bump is an eviction error or a
    * warning; without it downstream users get noisier warnings against this
    * library than against its peers. cats, fs2, http4s and circe all set it.
    */
  override def versionScheme: T[Option[VersionScheme]] = Task {
    Some(VersionScheme.EarlySemVer)
  }

  def pomSettings = PomSettings(
    description = docDescription,
    organization = "com.softinio",
    url = "https://github.com/softinio/verdict4s",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("softinio", "verdict4s"),
    developers = Seq(
      Developer(
        id = "softinio",
        name = "Salar Rahmanian",
        url = "https://www.softinio.com",
        email = "code@softinio.com"
      )
    )
  )

/** JVM-only settings. `-release` and `javacOptions` are meaningless on Scala.js,
  * so they live here rather than in the shared trait.
  */
trait Verdict4sJvmModule extends Verdict4sModule:

  /** JDK used to compile and run the JVM modules.
    *
    * Empty means "whatever JDK Mill itself runs on", which in this devshell is
    * the 21 that the nixpkgs `mill` wrapper pins -- the same version these
    * artifacts target. CI sets this to exercise newer runtimes, because
    * `--release 21` guarantees the API surface exists but not that the code
    * behaves identically on a later JVM.
    */
  override def jvmVersion: T[String] = Task.Input {
    Task.env.getOrElse("VERDICT4S_JVM", "")
  }

  def javacOptions = Seq("--release", "21")

  override def scalacOptions = Task {
    super.scalacOptions() ++ Seq("-release", "21")
  }

/** Scala.js-only settings. */
trait Verdict4sJsModule extends Verdict4sModule with ScalaJSModule:
  def scalaJSVersion = scalaJSVer

// ---------------------------------------------------------------------------
// verdict4s-core — effect-free. Models, codecs, request building, response
// parsing. No effect type, no HTTP client, no fs2: deliberately usable from
// any effect system, or none at all.
// ---------------------------------------------------------------------------

object `verdict4s-core` extends Module:

  trait Core extends Verdict4sModule:
    def artifactName   = "verdict4s-core"
    def docTitle       = "Verdict4s Core"
    def docDescription =
      "Effect-free core for verdict4s: models, JSON codecs, request building and response parsing for typed decision models."

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-core::$catsVersion",
      mvn"io.circe::circe-core::$circeVersion",
      mvn"io.circe::circe-parser::$circeVersion",
      mvn"io.github.iltotore::iron::$ironVersion",
      mvn"io.github.iltotore::iron-cats::$ironVersion",
      mvn"io.github.iltotore::iron-circe::$ironVersion"
    )

    trait CoreTests extends ScalaTests with TestModule.Munit:
      def mvnDeps = Seq(mvn"org.scalameta::munit::$munitVer")

  object jvm extends Cross[CoreJvm](scalaVersions)
  trait CoreJvm extends Core with Verdict4sJvmModule:
    object test extends CoreTests

  object js extends Cross[CoreJs](scalaVersions)
  trait CoreJs extends Core with Verdict4sJsModule:
    object test extends CoreTests with ScalaJSTests

// ---------------------------------------------------------------------------
// verdict4s-client — tagless-final client over an http4s `Client[F]` the
// caller supplies. Backend-agnostic: works with Ember, Fetch, Blaze, Netty,
// JDK, or an in-memory fake.
// ---------------------------------------------------------------------------

object `verdict4s-client` extends Module:

  trait Client extends Verdict4sModule:
    def artifactName   = "verdict4s-client"
    def docTitle       = "Verdict4s Client"
    def docDescription =
      "Backend-agnostic tagless-final client for verdict4s, built on an http4s Client[F] supplied by the caller."

    def mvnDeps = Seq(
      mvn"org.typelevel::cats-effect-kernel::$catsEffectVersion",
      mvn"co.fs2::fs2-core::$fs2Version",
      mvn"org.http4s::http4s-client::$http4sVersion",
      mvn"org.http4s::http4s-circe::$http4sVersion"
    )

    trait ClientTests extends ScalaTests with TestModule.Munit:
      def mvnDeps = Seq(
        mvn"org.scalameta::munit::$munitVer",
        mvn"org.typelevel::munit-cats-effect::$munitCeVer",
        mvn"org.typelevel::cats-effect::$catsEffectVersion",
        // `Client.fromHttpApp` + the dsl give an in-memory server, so the whole
        // suite runs on JVM and Node without touching the network.
        mvn"org.http4s::http4s-dsl::$http4sVersion"
      )

  object jvm extends Cross[ClientJvm](scalaVersions)
  trait ClientJvm extends Client with Verdict4sJvmModule:
    def moduleDeps = Seq(`verdict4s-core`.jvm(crossScalaVersion))
    object test extends ClientTests

  object js extends Cross[ClientJs](scalaVersions)
  trait ClientJs extends Client with Verdict4sJsModule:
    def moduleDeps = Seq(`verdict4s-core`.js(crossScalaVersion))
    object test extends ClientTests with ScalaJSTests

// ---------------------------------------------------------------------------
// verdict4s — batteries included. Adds a default transport so callers do not
// have to pick one: Ember on the JVM, Fetch on Scala.js (browser and Node).
// ---------------------------------------------------------------------------

object verdict4s extends Module:

  trait Bundle extends Verdict4sModule:
    def artifactName   = "verdict4s"
    def docTitle       = "Verdict4s"
    def docDescription =
      "A Scala client for typed decision models, which answer questions about your program state with typed choices, scores, and probabilities instead of text. Supports TypeSafe AI's Jev."

    def mvnDeps = Seq(mvn"org.typelevel::cats-effect::$catsEffectVersion")

    /** Nested `ScalaTests` inside a `PlatformScalaModule` *does* pick up the
      * platform source directories on Mill 1.1.8, so `test/src-jvm` needs no
      * wiring here. That is what lets the integration suite use `sys.env`,
      * which does not exist on Scala.js, without ever reaching the JS build.
      */
    trait BundleTests extends ScalaTests with TestModule.Munit:
      def mvnDeps = Seq(
        mvn"org.scalameta::munit::$munitVer",
        mvn"org.typelevel::munit-cats-effect::$munitCeVer",
        // For DocExamplesTest, which mirrors the narrative docs' examples.
        mvn"org.http4s::http4s-dsl::$http4sVersion"
      )

  object jvm extends Cross[BundleJvm](scalaVersions)
  trait BundleJvm extends Bundle with Verdict4sJvmModule:
    def moduleDeps = Seq(`verdict4s-client`.jvm(crossScalaVersion))
    override def mvnDeps = Task {
      super.mvnDeps() ++ Seq(
        mvn"co.fs2::fs2-io::$fs2Version",
        mvn"org.http4s::http4s-ember-client::$http4sVersion"
      )
    }
    object test extends BundleTests

  object js extends Cross[BundleJs](scalaVersions)
  trait BundleJs extends Bundle with Verdict4sJsModule:
    def moduleDeps = Seq(`verdict4s-client`.js(crossScalaVersion))
    override def mvnDeps = Task {
      super.mvnDeps() ++ Seq(mvn"org.http4s::http4s-dom::$http4sDomVersion")
    }
    object test extends BundleTests with ScalaJSTests

// ---------------------------------------------------------------------------
// verdict4s-examples — interop examples, compiled but never published.
//
// The `effect-systems` documentation page shows verdict4s driven from ZIO,
// Scala Future and the JDK's HttpClient. Those examples have to compile or they
// rot, so they live here as real sources. This is deliberately NOT a
// Verdict4sModule: it inherits no pomSettings and no publishVersion, so it
// cannot be published by accident, and the release glob ("__[3.3.8]") does not
// match it because it is not a Cross module.
//
// Pinned to the 3.3.8 LTS, the version the library publishes from, so the
// examples are proven against what users actually get. JVM only, one Scala
// version: one extra CI target rather than four. None of these dependencies
// appear anywhere else in the build.
// ---------------------------------------------------------------------------

object `verdict4s-examples` extends ScalaModule:
  def scalaVersion = "3.3.8"
  def moduleDeps   = Seq(verdict4s.jvm("3.3.8"))

  def mvnDeps = Seq(
    mvn"dev.zio::zio:2.1.19",
    mvn"dev.zio::zio-interop-cats:23.1.0.5"
  )

/** One API reference covering all three modules.
  *
  * Each module's own `docJar` documents only that module, so a type from
  * another layer -- `Ask` in the client docs, say -- renders as plain text
  * rather than a link, and a reader has to know which module a type lives in
  * before they can find it. This runs scaladoc once over the TASTy of all three,
  * so every cross-module reference links and there is one place to search.
  *
  * Only the site uses it. The per-module `docJar`s stay, because Maven Central
  * requires a javadoc jar for each published artifact.
  *
  * Built with the 3.3.8 LTS, not 3.9.0, and not only because that is what the
  * library publishes from. Scaladoc 3.9.0 stopped emitting the jQuery
  * `<script>` tag while its `ux.js` still navigates with `$.get`: every
  * same-origin link click calls `preventDefault()` and then throws
  * `ReferenceError: $ is not defined`, so no link in the reference works when
  * it is served over HTTP. 3.3.8 still emits the tag.
  */
object unidoc extends ScalaModule:
  def scalaVersion = "3.3.8"
  def moduleDeps   = Seq(verdict4s.jvm("3.3.8"))

  /** Document the three published modules, not this empty one. */
  override def docSources = Task {
    Seq(
      `verdict4s-core`.jvm("3.3.8").compile().classes,
      `verdict4s-client`.jvm("3.3.8").compile().classes,
      verdict4s.jvm("3.3.8").compile().classes
    )
  }

  def scalaDocOptions = Task {
    val version =
      Task.env.get("VERDICT4S_DOC_VERSION").getOrElse(verdict4s.jvm("3.3.8").publishVersion())
    withoutDefaultProject(super.scalaDocOptions()) ++ docOptions("Verdict4s", version)
  }

/** Documentation site: the Laika narrative pages plus the scaladoc API
  * reference, assembled into one directory.
  *
  *   - `mill docs.build` — render the site into `site/target/docs/site`, with
  *     each module's API reference under `api/<module>/`
  *   - `mill docs.preview` — build, then serve at http://localhost:4242
  *
  * Preview serves what `build` produced rather than re-rendering, so the two
  * cannot drift. They once did: the preview carried its own copy of the
  * transformer and lacked syntax highlighting the real build had.
  *
  * Note `docs.preview` holds Mill's workspace lock for as long as it serves, so
  * nothing else can build meanwhile.
  */
object docs extends Module:

  /** The combined API reference; see [[unidoc]]. */
  def apiDocs: T[PathRef] = Task { unidoc.docJar() }

  def build() = Task.Command {
    renderSite(apiDocs())
  }

  def preview() = Task.Command {
    val projectRoot = mill.api.BuildCtx.workspaceRoot
    renderSite(apiDocs())
    mill.api.BuildCtx.withFilesystemCheckerDisabled {
      os.proc("scala-cli", "run", (projectRoot / "scripts" / "LaikaPreview.scala").toString)
        .call(cwd = projectRoot, stdout = os.Inherit, stderr = os.Inherit)
    }
    ()
  }

  private def renderSite(api: PathRef): PathRef =
    val projectRoot = mill.api.BuildCtx.workspaceRoot
    val siteDir     = projectRoot / "site" / "target" / "docs" / "site"

    mill.api.BuildCtx.withFilesystemCheckerDisabled {
      println("Rendering the narrative site...")
      os.proc("scala-cli", "run", (projectRoot / "scripts" / "LaikaBuild.scala").toString)
        .call(cwd = projectRoot, stdout = os.Inherit, stderr = os.Inherit)

      // docJar writes the rendered HTML beside the jar, in `docs/`.
      val to = siteDir / "api"
      os.remove.all(to)
      os.copy(api.path / os.up / "docs", to, createFolders = true)
      println("  API reference: api/")
    }
    println(s"Site built at: $siteDir")
    PathRef(siteDir)
